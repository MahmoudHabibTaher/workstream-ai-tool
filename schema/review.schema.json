{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ws review",
  "type": "object",
  "required": [
    "task",
    "evidence",
    "range",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "task": {
      "type": "string"
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "range": {
      "type": "object",
      "required": [
        "from",
        "to",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "merge",
            "commit",
            "branch",
            "none"
          ]
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "added",
          "removed"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "added": {
            "type": [
              "integer",
              "null"
            ]
          },
          "removed": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "hunks": {
      "type": "object",
      "required": [
        "path",
        "text",
        "truncated"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "error": {
      "type": "string"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "commit",
        "gates",
        "evidenceText",
        "evidenceStatus",
        "reason",
        "items",
        "proposals",
        "gotchas"
      ],
      "properties": {
        "state": {
          "enum": [
            "branch",
            "landed",
            "none"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "ok",
              "detail",
              "blocking"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "ok": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              },
              "blocking": {
                "type": "boolean"
              }
            }
          }
        },
        "evidenceText": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceStatus": {
          "enum": [
            "",
            "done",
            "blocked"
          ]
        },
        "reason": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "item",
              "proof"
            ],
            "properties": {
              "n": {
                "type": "integer"
              },
              "item": {
                "type": "string"
              },
              "proof": {
                "type": "string"
              }
            }
          }
        },
        "proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "body"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            }
          }
        },
        "gotchas": {
          "type": "string"
        }
      }
    }
  }
}
