{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ws review",
  "type": "object",
  "required": [
    "task",
    "evidence",
    "range",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "task": {
      "type": "string"
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "range": {
      "type": "object",
      "required": [
        "from",
        "to",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "merge",
            "commit",
            "branch",
            "none"
          ]
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "added",
          "removed"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "added": {
            "type": [
              "integer",
              "null"
            ]
          },
          "removed": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "hunks": {
      "type": "object",
      "required": [
        "path",
        "text",
        "truncated"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "error": {
      "type": "string"
    }
  }
}
