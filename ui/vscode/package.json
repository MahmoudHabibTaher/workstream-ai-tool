{
  "name": "workstreams",
  "displayName": "Workstreams",
  "description": "Shows a workstream project's workstreams, tasks, reviews and health, all read from the ws CLI.",
  "version": "0.1.0",
  "publisher": "workstream",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension runs the ws CLI in the workspace, so it needs a trusted folder."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "Workstreams",
      "properties": {
        "workstreams.wsCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "default": [
            "ws"
          ],
          "markdownDescription": "The argv that runs the `ws` CLI; the extension appends each command's arguments. No shell parses it. For example `[\"python3\", \"-B\", \"-m\", \"workstream\"]` runs a checkout's own CLI."
        },
        "workstreams.agentCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "The argv that starts your coding agent for Run, Coordinate, Close and Abandon. The extension adds the prompt as the last argument and starts it in a terminal, at the project root; no shell parses it. Empty copies the prompt to the clipboard instead."
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "workstreams",
          "title": "Workstreams",
          "icon": "media/workstreams.svg"
        },
        {
          "id": "workstreams-review",
          "title": "Review",
          "icon": "media/review.svg"
        },
        {
          "id": "workstreams-health",
          "title": "Health",
          "icon": "media/health.svg"
        },
        {
          "id": "workstreams-budget",
          "title": "Budget",
          "icon": "media/budget.svg"
        }
      ]
    },
    "views": {
      "workstreams": [
        {
          "id": "workstreams.list",
          "name": "Workstreams"
        },
        {
          "id": "workstreams.tasks",
          "name": "Tasks",
          "when": "workstreams.selected"
        },
        {
          "id": "workstreams.task",
          "name": "Task",
          "when": "workstreams.selected"
        },
        {
          "id": "workstreams.graph",
          "name": "Graph",
          "when": "workstreams.selected"
        },
        {
          "id": "workstreams.overview",
          "name": "Overview",
          "when": "workstreams.selected"
        }
      ],
      "workstreams-review": [
        {
          "id": "workstreams.review",
          "name": "Review"
        }
      ],
      "workstreams-health": [
        {
          "id": "workstreams.health",
          "name": "Health"
        }
      ],
      "workstreams-budget": [
        {
          "id": "workstreams.budget",
          "name": "Budget"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "workstreams.list",
        "contents": "No workstream project is open in this window. `ws init` sets one up.\n[Refresh](command:workstreams.refresh)",
        "when": "!workstreams.hasProject"
      },
      {
        "view": "workstreams.list",
        "contents": "No open workstreams. To plan one, run `ws new <id>`, then `ws seed` it from an approved plan.\n[Show Done](command:workstreams.showDone)",
        "when": "workstreams.hasProject && !workstreams.showDone"
      },
      {
        "view": "workstreams.list",
        "contents": "This project has no workstreams yet. To plan one, run `ws new <id>`, then `ws seed` it from an approved plan.",
        "when": "workstreams.hasProject && workstreams.showDone"
      },
      {
        "view": "workstreams.tasks",
        "contents": "This workstream has no tasks yet. `ws seed` adds them from an approved plan."
      },
      {
        "view": "workstreams.task",
        "contents": "Pick a task in the Tasks or Graph view to see it here."
      },
      {
        "view": "workstreams.graph",
        "contents": "This workstream has no tasks to draw yet."
      },
      {
        "view": "workstreams.overview",
        "contents": "Pick a workstream in the Workstreams view to see its overview."
      },
      {
        "view": "workstreams.review",
        "contents": "No workstream project is open in this window. `ws init` sets one up.\n[Refresh](command:workstreams.refresh)",
        "when": "!workstreams.hasProject"
      },
      {
        "view": "workstreams.review",
        "contents": "Nothing is waiting for review.",
        "when": "workstreams.hasProject"
      },
      {
        "view": "workstreams.health",
        "contents": "No workstream project is open in this window. `ws init` sets one up.\n[Refresh](command:workstreams.refresh)",
        "when": "!workstreams.hasProject"
      },
      {
        "view": "workstreams.budget",
        "contents": "No workstream project is open in this window. `ws init` sets one up.\n[Refresh](command:workstreams.refresh)",
        "when": "!workstreams.hasProject"
      },
      {
        "view": "workstreams.budget",
        "contents": "`ws audit context` reported no budget rows.",
        "when": "workstreams.hasProject"
      }
    ],
    "commands": [
      {
        "command": "workstreams.refresh",
        "title": "Refresh",
        "category": "Workstreams",
        "icon": "$(refresh)"
      },
      {
        "command": "workstreams.showDone",
        "title": "Show Done",
        "category": "Workstreams",
        "icon": "$(eye)"
      },
      {
        "command": "workstreams.hideDone",
        "title": "Hide Done",
        "category": "Workstreams",
        "icon": "$(eye-closed)"
      },
      {
        "command": "workstreams.selectWorkstream",
        "title": "Select Workstream",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.selectTask",
        "title": "Show Task",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.pause",
        "title": "Pause",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.resume",
        "title": "Resume",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.sync",
        "title": "Sync Progress",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.unclaim",
        "title": "Unclaim",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.run",
        "title": "Run",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.coordinate",
        "title": "Coordinate",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.close",
        "title": "Close",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.abandon",
        "title": "Abandon…",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.openReviewFile",
        "title": "Open Diff",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.openEvidence",
        "title": "Open Evidence",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.openPlan",
        "title": "Plan",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.openProgress",
        "title": "Progress",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.openDecisions",
        "title": "Decisions",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.openHandoff",
        "title": "Handoff",
        "category": "Workstreams"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workstreams.refresh",
          "when": "view == workstreams.list",
          "group": "navigation@1"
        },
        {
          "command": "workstreams.refresh",
          "when": "view == workstreams.tasks",
          "group": "navigation@1"
        },
        {
          "command": "workstreams.refresh",
          "when": "view == workstreams.task",
          "group": "navigation@1"
        },
        {
          "command": "workstreams.refresh",
          "when": "view == workstreams.graph",
          "group": "navigation@1"
        },
        {
          "command": "workstreams.refresh",
          "when": "view == workstreams.overview",
          "group": "navigation@1"
        },
        {
          "command": "workstreams.refresh",
          "when": "view == workstreams.review",
          "group": "navigation@1"
        },
        {
          "command": "workstreams.refresh",
          "when": "view == workstreams.health",
          "group": "navigation@1"
        },
        {
          "command": "workstreams.refresh",
          "when": "view == workstreams.budget",
          "group": "navigation@1"
        },
        {
          "command": "workstreams.showDone",
          "when": "view == workstreams.list && !workstreams.showDone",
          "group": "navigation@2"
        },
        {
          "command": "workstreams.hideDone",
          "when": "view == workstreams.list && workstreams.showDone",
          "group": "navigation@2"
        },
        {
          "command": "workstreams.run",
          "when": "view =~ /^workstreams\\.(tasks|task|graph|overview)$/ && workstreams.selectedItem =~ /(^| )launch( |$)/",
          "group": "1_run@1"
        },
        {
          "command": "workstreams.coordinate",
          "when": "view =~ /^workstreams\\.(tasks|task|graph|overview)$/ && workstreams.selectedItem =~ /(^| )launch( |$)/",
          "group": "1_run@2"
        },
        {
          "command": "workstreams.close",
          "when": "view =~ /^workstreams\\.(tasks|task|graph|overview)$/ && workstreams.selectedItem =~ /(^| )launch( |$)/",
          "group": "1_run@3"
        },
        {
          "command": "workstreams.abandon",
          "when": "view =~ /^workstreams\\.(tasks|task|graph|overview)$/ && workstreams.selectedItem =~ /(^| )launch( |$)/",
          "group": "1_run@4"
        },
        {
          "command": "workstreams.pause",
          "when": "view =~ /^workstreams\\.(tasks|task|graph|overview)$/ && workstreams.selectedItem =~ /(^| )act:pause( |$)/",
          "group": "2_workstream@1"
        },
        {
          "command": "workstreams.resume",
          "when": "view =~ /^workstreams\\.(tasks|task|graph|overview)$/ && workstreams.selectedItem =~ /(^| )act:resume( |$)/",
          "group": "2_workstream@2"
        },
        {
          "command": "workstreams.sync",
          "when": "view =~ /^workstreams\\.(tasks|task|graph|overview)$/ && workstreams.selectedItem =~ /(^| )act:sync( |$)/",
          "group": "2_workstream@3"
        },
        {
          "command": "workstreams.unclaim",
          "when": "view =~ /^workstreams\\.(tasks|task|graph|overview)$/ && workstreams.selectedTaskItem =~ /(^| )act:unclaim( |$)/",
          "group": "3_task@1"
        },
        {
          "command": "workstreams.openPlan",
          "when": "view =~ /^workstreams\\.(tasks|task|graph|overview)$/ && workstreams.selectedItem =~ /^workstream( |$)/",
          "group": "4_open@1"
        },
        {
          "command": "workstreams.openProgress",
          "when": "view =~ /^workstreams\\.(tasks|task|graph|overview)$/ && workstreams.selectedItem =~ /^workstream( |$)/",
          "group": "4_open@2"
        },
        {
          "command": "workstreams.openDecisions",
          "when": "view =~ /^workstreams\\.(tasks|task|graph|overview)$/ && workstreams.selectedItem =~ /^workstream( |$)/",
          "group": "4_open@3"
        },
        {
          "command": "workstreams.openHandoff",
          "when": "view =~ /^workstreams\\.(tasks|task|graph|overview)$/ && workstreams.selectedItem =~ /^workstream( |$)/",
          "group": "4_open@4"
        }
      ],
      "commandPalette": [
        {
          "command": "workstreams.selectWorkstream",
          "when": "false"
        },
        {
          "command": "workstreams.selectTask",
          "when": "false"
        },
        {
          "command": "workstreams.showDone",
          "when": "!workstreams.showDone"
        },
        {
          "command": "workstreams.hideDone",
          "when": "workstreams.showDone"
        },
        {
          "command": "workstreams.pause",
          "when": "false"
        },
        {
          "command": "workstreams.resume",
          "when": "false"
        },
        {
          "command": "workstreams.sync",
          "when": "false"
        },
        {
          "command": "workstreams.unclaim",
          "when": "false"
        },
        {
          "command": "workstreams.run",
          "when": "false"
        },
        {
          "command": "workstreams.coordinate",
          "when": "false"
        },
        {
          "command": "workstreams.close",
          "when": "false"
        },
        {
          "command": "workstreams.abandon",
          "when": "false"
        },
        {
          "command": "workstreams.openReviewFile",
          "when": "false"
        },
        {
          "command": "workstreams.openEvidence",
          "when": "false"
        },
        {
          "command": "workstreams.openPlan",
          "when": "false"
        },
        {
          "command": "workstreams.openProgress",
          "when": "false"
        },
        {
          "command": "workstreams.openDecisions",
          "when": "false"
        },
        {
          "command": "workstreams.openHandoff",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "workstreams.run",
          "when": "view == workstreams.list && viewItem =~ /(^| )launch( |$)/",
          "group": "1_run@1"
        },
        {
          "command": "workstreams.coordinate",
          "when": "view == workstreams.list && viewItem =~ /(^| )launch( |$)/",
          "group": "1_run@2"
        },
        {
          "command": "workstreams.close",
          "when": "view == workstreams.list && viewItem =~ /(^| )launch( |$)/",
          "group": "1_run@3"
        },
        {
          "command": "workstreams.abandon",
          "when": "view == workstreams.list && viewItem =~ /(^| )launch( |$)/",
          "group": "1_run@4"
        },
        {
          "command": "workstreams.pause",
          "when": "view =~ /^workstreams\\.(list|tasks|health)$/ && viewItem =~ /(^| )act:pause( |$)/",
          "group": "2_workstream@1"
        },
        {
          "command": "workstreams.resume",
          "when": "view =~ /^workstreams\\.(list|tasks|health)$/ && viewItem =~ /(^| )act:resume( |$)/",
          "group": "2_workstream@2"
        },
        {
          "command": "workstreams.sync",
          "when": "view =~ /^workstreams\\.(list|tasks|health)$/ && viewItem =~ /(^| )act:sync( |$)/",
          "group": "2_workstream@3"
        },
        {
          "command": "workstreams.unclaim",
          "when": "view =~ /^workstreams\\.(list|tasks|health)$/ && viewItem =~ /(^| )act:unclaim( |$)/",
          "group": "3_task@1"
        },
        {
          "command": "workstreams.openPlan",
          "when": "view == workstreams.list && viewItem =~ /^workstream( |$)/",
          "group": "4_open@1"
        },
        {
          "command": "workstreams.openProgress",
          "when": "view == workstreams.list && viewItem =~ /^workstream( |$)/",
          "group": "4_open@2"
        },
        {
          "command": "workstreams.openDecisions",
          "when": "view == workstreams.list && viewItem =~ /^workstream( |$)/",
          "group": "4_open@3"
        },
        {
          "command": "workstreams.openHandoff",
          "when": "view == workstreams.list && viewItem =~ /^workstream( |$)/",
          "group": "4_open@4"
        },
        {
          "command": "workstreams.openReviewFile",
          "when": "view == workstreams.review && viewItem == file",
          "group": "4_open@1"
        },
        {
          "command": "workstreams.openEvidence",
          "when": "view == workstreams.review && viewItem == evidence",
          "group": "4_open@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test:logic": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/logic/*.test.ts",
    "test:integration": "node out/test/integration/runTest.js",
    "vsix": "vsce package --no-dependencies --skip-license --allow-missing-repository -o workstreams.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2"
  }
}
