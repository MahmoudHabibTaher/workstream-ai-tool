{
  "name": "workstreams",
  "displayName": "Workstreams",
  "description": "Shows a workstream project's registry, reviews and health, all read from the ws CLI.",
  "version": "0.1.0",
  "publisher": "workstream",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension runs the ws CLI in the workspace, so it needs a trusted folder."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "Workstreams",
      "properties": {
        "workstreams.wsCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "default": [
            "ws"
          ],
          "markdownDescription": "The argv that runs the `ws` CLI; the extension appends each command's arguments. No shell parses it. For example `[\"python3\", \"-B\", \"-m\", \"workstream\"]` runs a checkout's own CLI."
        },
        "workstreams.agentCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "The argv that starts your coding agent for Run, Coordinate, Close and Abandon. The extension adds the prompt as the last argument and starts it in a terminal, at the project root; no shell parses it. Empty copies the prompt to the clipboard instead."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workstreams",
          "title": "Workstreams",
          "icon": "media/workstreams.svg"
        }
      ]
    },
    "views": {
      "workstreams": [
        {
          "id": "workstreams.registry",
          "name": "Registry"
        },
        {
          "id": "workstreams.review",
          "name": "Review"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "workstreams.registry",
        "contents": "No workstream project is open in this window. `ws init` sets one up.\n[Refresh](command:workstreams.refresh)"
      }
    ],
    "commands": [
      {
        "command": "workstreams.refresh",
        "title": "Refresh",
        "category": "Workstreams",
        "icon": "$(refresh)"
      },
      {
        "command": "workstreams.showDone",
        "title": "Show Done",
        "category": "Workstreams",
        "icon": "$(eye)"
      },
      {
        "command": "workstreams.hideDone",
        "title": "Hide Done",
        "category": "Workstreams",
        "icon": "$(eye-closed)"
      },
      {
        "command": "workstreams.openDocument",
        "title": "Open in Markdown Preview",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.pause",
        "title": "Pause",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.resume",
        "title": "Resume",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.sync",
        "title": "Sync Progress",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.unclaim",
        "title": "Unclaim",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.run",
        "title": "Run",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.coordinate",
        "title": "Coordinate",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.close",
        "title": "Close",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.abandon",
        "title": "Abandon…",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.openReviewFile",
        "title": "Open Diff",
        "category": "Workstreams"
      },
      {
        "command": "workstreams.openEvidence",
        "title": "Open Evidence",
        "category": "Workstreams"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workstreams.refresh",
          "when": "view == workstreams.registry",
          "group": "navigation@1"
        },
        {
          "command": "workstreams.refresh",
          "when": "view == workstreams.review",
          "group": "navigation@1"
        },
        {
          "command": "workstreams.showDone",
          "when": "view == workstreams.registry && !workstreams.showDone",
          "group": "navigation@2"
        },
        {
          "command": "workstreams.hideDone",
          "when": "view == workstreams.registry && workstreams.showDone",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "workstreams.openDocument",
          "when": "false"
        },
        {
          "command": "workstreams.showDone",
          "when": "!workstreams.showDone"
        },
        {
          "command": "workstreams.hideDone",
          "when": "workstreams.showDone"
        },
        {
          "command": "workstreams.pause",
          "when": "false"
        },
        {
          "command": "workstreams.resume",
          "when": "false"
        },
        {
          "command": "workstreams.sync",
          "when": "false"
        },
        {
          "command": "workstreams.unclaim",
          "when": "false"
        },
        {
          "command": "workstreams.run",
          "when": "false"
        },
        {
          "command": "workstreams.coordinate",
          "when": "false"
        },
        {
          "command": "workstreams.close",
          "when": "false"
        },
        {
          "command": "workstreams.abandon",
          "when": "false"
        },
        {
          "command": "workstreams.openReviewFile",
          "when": "false"
        },
        {
          "command": "workstreams.openEvidence",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "workstreams.pause",
          "when": "view == workstreams.registry && viewItem =~ /(^| )act:pause( |$)/",
          "group": "1_write@1"
        },
        {
          "command": "workstreams.resume",
          "when": "view == workstreams.registry && viewItem =~ /(^| )act:resume( |$)/",
          "group": "1_write@2"
        },
        {
          "command": "workstreams.sync",
          "when": "view == workstreams.registry && viewItem =~ /(^| )act:sync( |$)/",
          "group": "1_write@3"
        },
        {
          "command": "workstreams.unclaim",
          "when": "view == workstreams.registry && viewItem =~ /(^| )act:unclaim( |$)/",
          "group": "1_write@4"
        },
        {
          "command": "workstreams.run",
          "when": "view == workstreams.registry && viewItem =~ /(^| )launch( |$)/",
          "group": "2_launch@1"
        },
        {
          "command": "workstreams.coordinate",
          "when": "view == workstreams.registry && viewItem =~ /(^| )launch( |$)/",
          "group": "2_launch@2"
        },
        {
          "command": "workstreams.close",
          "when": "view == workstreams.registry && viewItem =~ /(^| )launch( |$)/",
          "group": "2_launch@3"
        },
        {
          "command": "workstreams.abandon",
          "when": "view == workstreams.registry && viewItem =~ /(^| )launch( |$)/",
          "group": "2_launch@4"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test:logic": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/logic/*.test.ts",
    "test:integration": "node out/test/integration/runTest.js",
    "vsix": "vsce package --no-dependencies --skip-license --allow-missing-repository -o workstreams.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2"
  }
}
